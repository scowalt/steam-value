[Unit]
Description=Steam Value browser-backed Steam Status refresh
Wants=network-online.target
After=network-online.target steel-browser-steam-value.service
Requires=steel-browser-steam-value.service

[Service]
Type=oneshot
WorkingDirectory=%h/services/steam-value
EnvironmentFile=%h/.config/steam-value/arcane.env
Environment=STEEL_BASE_URL=http://100.97.172.16:3002
Environment=STEEL_CDP_URL=http://100.97.172.16:9224
ExecStart=%h/.local/share/mise/installs/node/24.15.0/bin/node scripts/sync-steam-status-browser.ts
TimeoutStartSec=10min
