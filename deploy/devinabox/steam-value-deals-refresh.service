[Unit]
Description=Steam Value IsThereAnyDeal offer refresh
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/steam-value/current
EnvironmentFile=%h/.config/steam-value-d1/deals.env
ExecStart=%h/.bun/bin/bun scripts/refresh-deals.ts
TimeoutStartSec=45min
Nice=10
UMask=0077
NoNewPrivileges=true
